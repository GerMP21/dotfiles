{
  "layer": "top",
  "position": "top",
  "height": 26,
  "modules-left": ["battery", "cpu", "memory", "disk"],
  "modules-center": ["niri/workspaces"],
  "modules-right": ["niri/language", "network", "wireplumber", "power-profiles-daemon", "clock", "tray"],
  "niri/workspaces": { "format": "{index}" },
  "niri/language": { "format": "{short}", "tooltip": false },
  "battery": { "format": "BAT {capacity}%", "states": { "warning": 25, "critical": 10 } },
  "cpu": { "format": "CPU {usage}%", "interval": 2 },
  "memory": { "format": "RAM {percentage}%" },
  "disk": { "format": "/ {percentage_used}%", "path": "/" },
  "network": { "format-wifi": "{essid} {signalStrength}%", "format-ethernet": "ETH", "format-disconnected": "offline", "on-click": "foot nmtui" },
  "wireplumber": { "format": "VOL {volume}%", "format-muted": "muted", "on-click": "pavucontrol" },
  "power-profiles-daemon": {
    "format": "{icon}",
    "format-icons": { "power-saver": "ECO", "balanced": "BAL", "performance": "PERF", "default": "BAL" },
    "tooltip-format": "Power profile: {profile} (click to cycle)"
  },
  "clock": { "format": "{:%a %d %b  %H:%M}", "tooltip-format": "<tt>{calendar}</tt>" },
  "tray": { "spacing": 8 }
}
