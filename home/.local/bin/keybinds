#!/usr/bin/env python3
"""Show every niri keybinding in columns. Mod+Shift+Escape opens it.

Reads the binds { } block of ~/.config/niri/config.kdl, so new binds show up
without editing this script:
- A comment right after a blank line starts a section ("// Apps"); the text
  before the first ":", "(", "." or "," is the heading. Comments right after
  a bind are notes and are skipped.
- A bind's description is its hotkey-overlay-title, or else its action
  ("focus-column-left" becomes "Focus column left").
- Keys with the same description share a line, and runs like Mod+1 … Mod+9
  are shortened to one (Mod+1–9).

Usage: keybinds [config.kdl]. Any key closes it. It uses as few columns as
fit the window, and joins keys that share modifiers: Mod+H/← is Mod+H or Mod+←.
"""
import os
import re
import shutil
import sys
import termios
import tty

CONFIG = os.path.expanduser(sys.argv[1] if len(sys.argv) > 1 else "~/.config/niri/config.kdl")

BOLD, BLUE, YELLOW, DIM, RESET = "\033[1m", "\033[1;34m", "\033[33m", "\033[2m", "\033[0m"

# Friendlier names for xkb key names
KEY_NAMES = {
    "Return": "Enter", "masculine": "º", "grave": "`", "Minus": "-", "Plus": "+",
    "Equal": "=", "Comma": ",", "Period": ".", "Slash": "/", "Space": "Space",
    "WheelScrollDown": "Scroll↓", "WheelScrollUp": "Scroll↑",
    "WheelScrollLeft": "Scroll←", "WheelScrollRight": "Scroll→",
    "Left": "←", "Right": "→", "Up": "↑", "Down": "↓",
    "XF86AudioRaiseVolume": "Vol+", "XF86AudioLowerVolume": "Vol−",
    "XF86AudioMute": "Mute", "XF86AudioMicMute": "MicMute",
    "XF86AudioPlay": "Play", "XF86AudioPause": "Pause",
    "XF86AudioNext": "Next", "XF86AudioPrev": "Prev",
    "XF86MonBrightnessUp": "Bright+", "XF86MonBrightnessDown": "Bright−",
}

BIND = re.compile(r'^\s*(?P<key>[A-Za-z0-9+_]+)(?P<props>(?:\s+[\w-]+=(?:"[^"]*"|\S+))*)\s*\{\s*(?P<action>.*?)\s*;?\s*\}\s*$')
TITLE = re.compile(r'hotkey-overlay-title="([^"]*)"')


def pretty_key(key):
    return "+".join(KEY_NAMES.get(part, part) for part in key.split("+"))


def describe(action):
    """'set-column-width "-10%"' -> 'Set column width -10%'."""
    name, _, args = action.partition(" ")
    words = name.replace("-", " ")
    args = re.sub(r'r?#*"([^"]*)"#*', r"\1", args).strip()
    text = f"{words} {args}".strip()
    return text[:1].upper() + text[1:]


def read_sections(path):
    with open(path, encoding="utf-8") as f:
        text = f.read()
    start = text.find("binds {")
    if start < 0:
        sys.exit(f"No binds {{ }} block in {path}")
    sections, current, prev_blank = [], None, True
    for line in text[start + len("binds {"):].splitlines():
        stripped = line.strip()
        if stripped == "}" and not line.startswith(" "):
            break  # end of the binds block
        if not stripped:
            prev_blank = True
            continue
        if stripped.startswith("//"):
            if prev_blank:
                heading = re.split(r"[:(.,]", stripped.lstrip("/ ").strip(), maxsplit=1)[0].strip()
                current = [heading, []]
                sections.append(current)
            prev_blank = False
            continue
        prev_blank = False
        m = BIND.match(line)
        if not m:
            continue
        title = TITLE.search(m["props"] or "")
        desc = title.group(1) if title else describe(m["action"])
        if current is None:
            current = ["General", []]
            sections.append(current)
        current[1].append((m["key"], desc))
    return [(h, merge(entries)) for h, entries in sections if entries]


def join_keys(keys):
    """['Mod+H', 'Mod+Left'] -> 'Mod+H/←': keys with the same modifiers share them."""
    groups = {}
    for key in keys:
        mods, _, last = key.rpartition("+")
        if key.endswith("+Plus") or key == "Plus":
            mods, last = key[:-len("Plus")].rstrip("+"), "Plus"
        groups.setdefault(mods, []).append(KEY_NAMES.get(last, last))
    parts = []
    for mods, lasts in groups.items():
        prefix = "+".join(KEY_NAMES.get(m, m) for m in mods.split("+")) + "+" if mods else ""
        parts.append(prefix + "/".join(lasts))
    return " ".join(parts)


def merge(entries):
    """Join keys with the same description, then shorten numbered runs."""
    joined = {}
    for key, desc in entries:
        joined.setdefault(desc, []).append(key)
    rows = [(join_keys(keys), desc) for desc, keys in joined.items()]

    out, i = [], 0
    while i < len(rows):
        km = re.fullmatch(r"(.*?)(\d)", rows[i][0])
        dm = re.fullmatch(r"(.*?)(\d+)", rows[i][1])
        j = i
        if km and dm:
            while j + 1 < len(rows):
                k2 = re.fullmatch(r"(.*?)(\d)", rows[j + 1][0])
                d2 = re.fullmatch(r"(.*?)(\d+)", rows[j + 1][1])
                if (k2 and d2 and k2[1] == km[1] and d2[1] == dm[1]
                        and int(k2[2]) == int(km[2]) + (j + 1 - i)):
                    j += 1
                else:
                    break
        if j - i >= 2:
            last_k = re.fullmatch(r"(.*?)(\d)", rows[j][0])[2]
            last_d = re.fullmatch(r"(.*?)(\d+)", rows[j][1])[2]
            out.append((f"{km[1]}{km[2]}–{last_k}", f"{dm[1]}{dm[2]}–{last_d}"))
        else:
            out.extend(rows[i:j + 1])
        i = j + 1
    return out


def split_columns(blocks, ncols):
    """Fill ncols columns in order, starting a new one at a section boundary."""
    total = sum(len(b) for b in blocks)
    target = -(-total // ncols)
    columns, col = [], []
    for b in blocks:
        if col and len(col) + len(b) > target and len(columns) < ncols - 1:
            columns.append(col)
            col = []
        col.extend(b)
    columns.append(col)
    return columns


def natural_width(col):
    keyw = max((len(r[0]) for kind, r in col if kind == "row"), default=0)
    descw = max((len(r[1]) for kind, r in col if kind == "row"), default=0)
    headw = max((len(v) for kind, v in col if kind == "head"), default=0)
    return keyw, max(keyw + 2 + descw, headw)


def render(sections, width, height):
    """As few columns as fit the window's height, each only as wide as its
    content, centered. Descriptions are shortened only if the window is too
    narrow for that."""
    blocks = [[("head", h)] + [("row", r) for r in rows] for h, rows in sections]
    gap, min_colw = 3, 34
    rows_free = max(height - 1, 10)  # minus the title line
    max_cols = max(1, min(4, (width + gap) // (min_colw + gap)))
    columns = None
    for n in range(1, max_cols + 1):
        columns = split_columns(blocks, n)
        if max(len(c) for c in columns) <= rows_free:
            break

    widths = [natural_width(c) for c in columns]
    total = sum(w for _, w in widths) + gap * (len(columns) - 1)
    room = width - gap * (len(columns) - 1)
    if total > width:  # shrink every column by the same share; keys keep 8+, descriptions 10+
        natural = sum(w for _, w in widths)
        shrunk = []
        for k, w in widths:
            colw = room * w // natural
            shrunk.append((max(min(k, colw - 12), min(k, 8)), colw))
        widths = shrunk
        total = sum(w for _, w in widths) + gap * (len(columns) - 1)
    margin = " " * max((width - total) // 2, 0)

    def column_lines(col, keyw, colw):
        out = []
        for kind, val in col:
            if kind == "head":
                out.append((f"{BLUE}{val[:colw]}{RESET}", len(val[:colw])))
                continue
            key, desc = val
            key = key if len(key) <= keyw else key[:keyw - 1] + "…"
            space = colw - keyw - 2
            desc = desc if len(desc) <= space else desc[:max(space - 1, 0)] + "…"
            out.append((f"{YELLOW}{key.ljust(keyw)}{RESET}  {desc}", keyw + 2 + len(desc)))
        return out, colw

    rendered = [column_lines(c, k, w) for c, (k, w) in zip(columns, widths)]
    lines = []
    for i in range(max(len(c) for c, _ in rendered)):
        cells = []
        for c, colw in rendered:
            text, shown = c[i] if i < len(c) else ("", 0)
            cells.append(text + " " * (colw - shown))
        lines.append(margin + (" " * gap).join(cells))
    return lines


def wait_for_key():
    if not sys.stdin.isatty():
        return
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        os.read(fd, 1)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)


def main():
    try:
        sections = read_sections(CONFIG)
    except OSError as e:
        print(f"Can't read {CONFIG}: {e}")
        wait_for_key()
        return 1
    size = shutil.get_terminal_size((160, 50))
    print(f"{BOLD}niri keybindings{RESET}  {DIM}Mod = Super · any key closes · {CONFIG}{RESET}")
    for line in render(sections, size.columns, size.lines):
        print(line.rstrip())
    wait_for_key()
    return 0


if __name__ == "__main__":
    sys.exit(main())
